# Copy to .env (never commit the real file). Real environment variables override this file.

APP_ENV=development

# Local model served by Ollama. The model must support image input (gemma3:4b does).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=90


# CORS: the origin of the frontend dev server (the dev server also proxies /api, so this is a fallback)
FRONTEND_ORIGIN=http://localhost:5173

# "gemma" = real inference through Ollama. "mock" = a FIXED fake invoice for every upload.
# Mock mode is for development and demos only; records are labelled and flagged as mock.
EXTRACTION_MODE=gemma

# Arithmetic check tolerance in INR (covers per-line rounding on invoices)
ARITHMETIC_TOLERANCE=1.00

# Upload limits
MAX_UPLOAD_MB=10
MAX_REQUEST_MB=25
MAX_PDF_PAGES=5

# Optional: full path to the Tesseract executable if it is not on PATH
# (Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe)
# TESSERACT_CMD=

# Frontend build-time setting (only needed when the API is on a different origin, for example on Render):
# VITE_API_BASE_URL=https://your-backend.example.com
